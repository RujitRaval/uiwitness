{
  "name": "uiwitness-core",
  "version": "0.26.9",
  "description": "Core contracts for UIWitness UI product-state coverage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RujitRaval/uiwitness.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RujitRaval/uiwitness#readme",
  "bugs": {
    "url": "https://github.com/RujitRaval/uiwitness/issues"
  },
  "keywords": [
    "ui-testing",
    "state-coverage",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. packages/core/test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "canonicalize": "4.0.0",
    "jsonc-parser": "3.3.1",
    "tldts": "7.4.11",
    "zod": "4.5.3"
  }
}
