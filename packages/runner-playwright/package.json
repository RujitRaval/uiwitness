{
  "name": "uiwitness-runner-playwright",
  "version": "0.26.9",
  "description": "Playwright execution lifecycle for UIWitness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RujitRaval/uiwitness.git",
    "directory": "packages/runner-playwright"
  },
  "homepage": "https://github.com/RujitRaval/uiwitness#readme",
  "bugs": {
    "url": "https://github.com/RujitRaval/uiwitness/issues"
  },
  "keywords": [
    "playwright",
    "ui-testing",
    "state-coverage"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public-site-contract": {
      "types": "./dist/public-site-contract.d.ts",
      "import": "./dist/public-site-contract.js"
    }
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.build.json",
    "pretypecheck": "corepack pnpm --filter uiwitness-core build && corepack pnpm --filter uiwitness-report build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "uiwitness-core": "workspace:*",
    "uiwitness-report": "workspace:*",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
