{
  "name": "uiwitness-workspace",
  "version": "0.26.9",
  "private": true,
  "description": "Every exercised UI state leaves evidence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "benchmark:contract": "corepack pnpm --filter uiwitness-core build && node scripts/contract-core-benchmark.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "build": "corepack pnpm --recursive --if-present build",
    "lint": "corepack pnpm brand:check && eslint . --max-warnings=0",
    "launch:assets": "corepack pnpm --filter @uiwitness/example-nextjs launch:assets",
    "release:check": "node scripts/check-release-packages.mjs",
    "release:package-smoke": "corepack pnpm build && node scripts/release-package-smoke.mjs",
    "release:registry-public-url-smoke": "node scripts/public-url-registry-smoke.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:sync-version": "node scripts/check-release-packages.mjs --sync",
    "test": "corepack pnpm build && vitest run && node --test scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && corepack pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
